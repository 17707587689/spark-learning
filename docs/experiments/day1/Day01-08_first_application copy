```python
from pyspark.sql import SparkSession

spark = (
    SparkSession.builder
    .appName("FirstSparkApp")
    .getOrCreate()
)

print("Spark version:", spark.version)
print("Master:", spark.sparkContext.master)
print("App ID:", spark.sparkContext.applicationId)
print("App Name:", spark.sparkContext.appName)

customer_df = spark.read.parquet(
    "hdfs:///user/hive/warehouse/dim/customer_shuffle"
)

print("\n=== Schema ===")
customer_df.printSchema()

print("\n=== Partitions ===")
print(customer_df.rdd.getNumPartitions())

print("\n=== Data ===")
customer_df.show(10)

print("\n=== Count ===")
customer_count = customer_df.count()
print("Customer count:", customer_count)

print("\n=== Explain ===")
customer_df.explain(True)
```
